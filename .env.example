# Copy this file to .env and change the secrets before going live.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pm:pm_password@localhost:5432/pm_platform?schema=public
# Long random string, for example from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
# Address of the web app (used for CORS and invitation links). Several can be separated by commas.
WEB_ORIGIN=http://localhost:5173


# ── Background jobs (BullMQ on Redis): reminders, overdue alerts, email/SMS sending ──
REDIS_URL=redis://localhost:6379
# false = run without Redis (development only): alerts are checked every minute in the API process.
JOBS_ENABLED=true
# false = this process does not run the job workers (for a separate worker process later).
RUN_WORKERS=true

# ── Email (SRS SI-1). Without SMTP_URL, development writes emails to the log instead. ──
# SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=PM Platform <no-reply@example.com>

# ── SMS through Twilio (SRS SI-2). Without these, development writes SMS to the log instead. ──
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15550001111

# ── Files (attachments). Stored on disk here; back this folder up with the database. ──
UPLOAD_DIR=./uploads

# ── GitHub App (SRS SI-4). Create one at github.com → Settings → Developer settings → GitHub Apps. ──
# Permissions: Metadata (read), Contents (read), Pull requests (read). Events: Push, Pull request.
# Webhook URL: https://<your-server>/api/v1/webhooks/github   Setup (callback) URL: https://<your-server>/api/v1/github/callback
# Tick "Request user authorization (OAuth) during installation" and set the client id and secret below.
# GITHUB_APP_SLUG=pm-platform
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=another-long-random-string
# GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxx

# ── Security ──
# Behind a reverse proxy / load balancer: how many proxies to trust, so rate limits see the real client address.
# TRUST_PROXY=1
# Key for encrypting two-factor secrets in the database (32+ characters). Defaults to JWT_ACCESS_SECRET; set it
# separately so the JWT secret can be changed later without breaking everyone's two-factor login.
# DATA_ENCRYPTION_KEY=

# ── Browser push notifications (SRS FR-4.6). Make the keys once with: npx web-push generate-vapid-keys ──
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
