{
  "name": "pm-platform-backend",
  "version": "1.1.1",
  "private": true,
  "description": "Backend API for the Project Management Platform (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:logic": "ts-node test/logic.check.ts && ts-node test/projects.check.ts && ts-node test/tasks.check.ts && ts-node test/notifications.check.ts && ts-node test/sprints-issues.check.ts && ts-node test/messaging.check.ts && ts-node test/step7.check.ts && ts-node test/github.check.ts && ts-node test/account.check.ts && ts-node test/step10.check.ts",
    "test:e2e": "node test/e2e.mjs",
    "test:integration": "ts-node test/jobs.integration.ts && ts-node test/http.integration.ts && ts-node test/push.integration.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:add-extras": "node scripts/add-extras.js",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "10.4.22",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "5.11.1",
    "nodemailer": "6.10.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "3.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "2.3.0",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "6.4.24",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
