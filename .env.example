# Copy this file to .env and change the secrets before going live.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pm:pm_password@localhost:5432/pm_platform?schema=public
# Long random string, for example from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
# Address of the web app (used for CORS and invitation links). Several can be separated by commas.
WEB_ORIGIN=http://localhost:5173

